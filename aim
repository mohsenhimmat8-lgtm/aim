		TweenService:Create(gearButton, TWEEN_MED, {Rotation = 90}):Play()
	else
		TweenService:Create(settingsClip, TWEEN_MED, {Size = UDim2.new(1, 0, 0, 0)}):Play()
		TweenService:Create(gearButton, TWEEN_MED, {Rotation = 0}):Play()
