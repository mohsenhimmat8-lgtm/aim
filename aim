local camera = Workspace.CurrentCamera

-- ===== CONFIG (defaults; adjustable live via sliders) =====
local settings = {
	Radius = 60,        -- studs, how far the assist can "see"
	ConeAngle = 8,       -- degrees, half-angle of the targeting cone
	Strength = 0.12,     -- 0-1, how strongly camera nudges per frame
}

local SLIDER_RANGES = {
	Radius = {min = 10, max = 150},
	ConeAngle = {min = 1, max = 30},
	Strength = {min = 0.01, max = 0.5},
}

local TOGGLE_KEY = Enum.KeyCode.F

-- ===== STATE =====
