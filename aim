--[[
    AimAssistGUI.lua
    Place this as a LocalScript inside StarterPlayerScripts.

    What it does:
    - Spawns a GUI with:
        - Aim Helper toggle (also bound to F key)
        - Team Check toggle (when ON, never assists onto teammates)
        - Settings panel with sliders: Radius, Cone Angle, Strength
    - When Aim Helper is ON, gently nudges your camera toward the
      nearest valid target within a cone in front of you (soft aim
      assist, similar to console shooter aim assist)

    You WILL likely need to adjust:
    - How "valid targets" are identified (currently: any Humanoid
      in workspace, excluding your own character; teammates are
      skipped only if Team Check is enabled)
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

