-- Deterministic sizing: measure content heights once layout has settled,
-- then drive frame height explicitly instead of relying on signals firing
-- mid-tween (which can be unreliable).
local TITLE_HEIGHT = 42
local ROW_GAP = 8
local baseBodyHeight = 0    -- height of the 4 toggle rows (settings collapsed)
local panelHeight = 0        -- height of the settings panel content

local settingsOpen = false
local minimized = false

local function currentTargetHeight()
	if minimized then
		return TITLE_HEIGHT
	elseif settingsOpen then
		return TITLE_HEIGHT + baseBodyHeight + ROW_GAP + panelHeight
	else
		return TITLE_HEIGHT + baseBodyHeight
	end
end

