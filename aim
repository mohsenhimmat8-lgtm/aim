local isCurrentlyLocked = false

local function updateFOVCircle()
	local screenCenter = camera.ViewportSize / 2
	local vFOV = math.rad(camera.FieldOfView)
	local screenHeight = camera.ViewportSize.Y
	local pixelsPerRadian = screenHeight / vFOV
	local pixelRadius = math.rad(settings.ConeAngle) * pixelsPerRadian

	fovCircle.Position = UDim2.new(0, screenCenter.X, 0, screenCenter.Y)
	fovCircle.Size = UDim2.new(0, pixelRadius * 2, 0, pixelRadius * 2)
end

-- Sets the FOV circle + reticle to reflect whether we're actively locked on.
-- locked=true also triggers a quick pop animation the first time a lock is acquired.
local function setLockState(locked)
	if locked == isCurrentlyLocked then return end
	isCurrentlyLocked = locked

	local ringColor = locked and THEME.On or THEME.Accent
	TweenService:Create(fovStroke, TWEEN_MED, {Color = ringColor}):Play()

	if locked then
		TweenService:Create(fovStroke, TWEEN_FAST, {Thickness = 3}):Play()
		task.delay(0.15, function()
			TweenService:Create(fovStroke, TWEEN_MED, {Thickness = 1.5}):Play()
		end)
	end

	reticle.Visible = locked
	if locked then
		reticle.Size = UDim2.new(0, 50, 0, 50)
		TweenService:Create(reticle, TWEEN_SPRING, {Size = UDim2.new(0, 34, 0, 34)}):Play()
	end
end

-- Raycasts from the camera to the target's actual world position to confirm
-- there's really nothing blocking your view before showing the reticle.
local losRayParams = RaycastParams.new()
losRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasLineOfSight(targetPart)
	if not targetPart then return false end
	local character = player.Character
	losRayParams.FilterDescendantsInstances = {character, targetPart.Parent}

	local origin = camera.CFrame.Position
	local direction = targetPart.Position - origin
	local result = Workspace:Raycast(origin, direction, losRayParams)

	-- if the ray hits nothing before reaching the target, sight is clear
	return result == nil
end

-- Projects the target's world position to a screen position and updates the
-- reticle there, hiding it if the target is off-screen or behind something.
local function updateReticle(targetPart)
	if not targetPart or not aimHelperEnabled then
		setLockState(false)
		return
	end

	if not hasLineOfSight(targetPart) then
		setLockState(false)
		return
	end

	local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
	if not onScreen then
		setLockState(false)
		return
	end

	setLockState(true)
	reticle.Position = UDim2.new(0, screenPoint.X, 0, screenPoint.Y)
end

-- ===== TOGGLE LOGIC =====
local function refreshVisuals(animated)
	if animated == nil then animated = true end
	setPillState(aimPill, aimKnob, aimHelperEnabled, animated)
	setPillState(teamPill, teamKnob, teamCheckEnabled, animated)
	setPillState(aimingPill, aimingKnob, onlyWhileAiming, animated)
	setPillState(doubleJumpPill, doubleJumpKnob, doubleJumpEnabled, animated)

	local dotColor = aimHelperEnabled and THEME.On or THEME.Off
	TweenService:Create(statusDot, TWEEN_MED, {BackgroundColor3 = dotColor}):Play()
	TweenService:Create(dotGlow, TWEEN_MED, {ImageColor3 = dotColor}):Play()

	fovCircle.Visible = aimHelperEnabled
	if not aimHelperEnabled then
		setLockState(false)
	end
end

