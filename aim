local function updateFOVCircle()
	local screenCenter = camera.ViewportSize / 2
	-- approximate on-screen radius from the cone angle and current FOV
	local vFOV = math.rad(camera.FieldOfView)
	local screenHeight = camera.ViewportSize.Y
	local pixelsPerRadian = screenHeight / vFOV
	local pixelRadius = math.rad(settings.ConeAngle) * pixelsPerRadian

	fovCircle.Position = UDim2.new(0, screenCenter.X, 0, screenCenter.Y)
	fovCircle.Size = UDim2.new(0, pixelRadius * 2, 0, pixelRadius * 2)
end

