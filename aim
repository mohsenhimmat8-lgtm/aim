-- ===== TARGET FINDING (performance-optimized) =====
local CollectionService = game:GetService("CollectionService")

-- If your NPCs are tagged with CollectionService (e.g. CollectionService:AddTag(npcModel, "Enemy")),
-- they'll automatically be picked up here too. Change the tag name if yours differs.
local NPC_TAG = "Enemy"

local function isValidTarget(model)
	if not model or model == player.Character then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	if teamCheckEnabled then
		local targetPlayer = Players:GetPlayerFromCharacter(model)
		if targetPlayer and player.Team and targetPlayer.Team == player.Team then
			return false
		end
	end

	return true
end

-- Builds a small candidate list instead of scanning the whole Workspace tree.
-- Sources: all other Players' characters + anything tagged NPC_TAG.
local function getCandidateModels()
	local candidates = {}

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			table.insert(candidates, otherPlayer.Character)
		end
	end

	for _, model in ipairs(CollectionService:GetTagged(NPC_TAG)) do
		table.insert(candidates, model)
	end

	return candidates
end

-- Scores candidates by a mix of angle-from-center and distance so a close,
-- slightly-off-center target can beat a far, dead-center one.
local function findBestTarget()
	local character = player.Character
	if not character then return nil end

	local camCFrame = camera.CFrame
	local camPos = camCFrame.Position
	local camLookVector = camCFrame.LookVector
	local maxAngle = math.rad(settings.ConeAngle)

	local bestTarget = nil
	local bestScore = math.huge

	for _, model in ipairs(getCandidateModels()) do
		if isValidTarget(model) then
			local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if targetRoot then
				local toTarget = targetRoot.Position - camPos
				local distance = toTarget.Magnitude

				if distance <= settings.Radius and distance > 0 then
					local direction = toTarget.Unit
					local angle = math.acos(math.clamp(camLookVector:Dot(direction), -1, 1))

					if angle < maxAngle then
						local angleScore = angle / maxAngle
						local distScore = distance / settings.Radius
						local score = (angleScore * 0.7) + (distScore * 0.3)

						if score < bestScore then
							bestScore = score
							bestTarget = targetRoot
						end
					end
				end
			end
		end
	end

	return bestTarget
end

-- ===== CAMERA NUDGE (per-frame, target search throttled but responsive) =====
local SEARCH_INTERVAL = 0.05 -- seconds between full re-searches while locked on (20x/sec)
local timeSinceSearch = math.huge
local cachedTarget = nil

-- Checks the currently locked target is still alive, present, and still
-- inside the assist radius/cone. Cheap — just re-tests one candidate.
local function isCachedTargetStillValid(target, camPos, camLookVector)
	if not target or not target.Parent then return false end

	local model = target.Parent
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	if teamCheckEnabled then
		local targetPlayer = Players:GetPlayerFromCharacter(model)
		if targetPlayer and player.Team and targetPlayer.Team == player.Team then
			return false
		end
	end

	local toTarget = target.Position - camPos
	local distance = toTarget.Magnitude
	if distance <= 0 or distance > settings.Radius then return false end

	local angle = math.acos(math.clamp(camLookVector:Dot(toTarget.Unit), -1, 1))
	-- give a little extra slack (1.5x) so it doesn't drop the lock the instant
	-- the target grazes the cone edge; findBestTarget will re-lock properly anyway
	if angle > math.rad(settings.ConeAngle) * 1.5 then return false end

	return true
end

RunService.RenderStepped:Connect(function(dt)
	if aimHelperEnabled then
		updateFOVCircle()
	end

	if not aimHelperEnabled then return end
	if onlyWhileAiming and not isAimingHeld then return end

	local camCFrame = camera.CFrame
	local camPos = camCFrame.Position
	local camLookVector = camCFrame.LookVector

	-- If we don't currently have a target, search every frame until we get one
	-- (cheap now that the candidate list is small). Once locked, only
	-- re-search periodically, but keep validating the lock every frame.
	if not cachedTarget or not isCachedTargetStillValid(cachedTarget, camPos, camLookVector) then
		cachedTarget = findBestTarget()
		timeSinceSearch = 0
	else
		timeSinceSearch += dt
		if timeSinceSearch >= SEARCH_INTERVAL then
			timeSinceSearch = 0
			local newBest = findBestTarget()
			if newBest then
				cachedTarget = newBest
			end
		end
	end

	local target = cachedTarget
	if not target or not target.Parent then
		currentSmoothLook = nil
		return
	end

	local toTarget = (target.Position - camPos).Unit

	local currentLook = currentSmoothLook or camCFrame.LookVector
	-- Smoothness slider softens the lerp: higher smoothness = smaller effective step
	local effectiveStrength = settings.Strength * (1 - settings.Smoothness)
	effectiveStrength = math.clamp(effectiveStrength, 0.01, 1)

	local newLook = currentLook:Lerp(toTarget, effectiveStrength)
	currentSmoothLook = newLook

	camera.CFrame = CFrame.new(camPos, camPos + newLook)
end)
